# ─── Base de données ──────────────────────────────────────────────────────
# Chaîne de connexion PostgreSQL.
# La plupart des bases managées imposent SSL : ajoutez ?sslmode=require
DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/base?sslmode=require

# ─── Sessions ─────────────────────────────────────────────────────────────
# Clé de signature des JWT de session. 32 octets minimum.
# Générer :  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ─── Compte administrateur (script npm run db:seed-admin) ─────────────────
# Jamais de valeur par défaut ici : le script refuse de s'exécuter sans elles.
# ADMIN_PASSWORD doit faire au moins 12 caractères.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur

# ─── Site ─────────────────────────────────────────────────────────────────
# URL publique, utilisée par metadataBase pour les liens et aperçus de partage.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
